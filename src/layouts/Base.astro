---
import site from '../../site.config.mjs';

interface Props {
  title?: string;
  description?: string;
  canonical: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  jsonLd?: Record<string, unknown>[];
}

const { title, description = site.description, canonical, type = title ? 'article' : 'website', published, modified, jsonLd = [] } = Astro.props;
const pageTitle = title ? `${title} - ${site.title}` : `${site.title} | ${site.author}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.author} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;800&family=JetBrains+Mono:wght@400;500&display=swap" />
  </head>
  <body>
    <header class="topbar">
      <a class="mark" href="/">{site.title}<span class="dot" aria-hidden="true"></span></a>
      <nav>
        <a href="/">Posts</a>
        <a href={site.substack}>Substack ↗</a>
      </nav>
      <a class="btn" href={`${site.substack}/subscribe`}>Subscribe</a>
    </header>
    <main class="wide"><slot /></main>
    <footer class="footer">
      <span>© {new Date().getFullYear()} {site.author}</span>
      <nav><a href="/rss.xml">RSS</a><a href={site.substack}>Substack</a></nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fff; --ink: #111; --fg: #1c1917; --mute: #757676; --rule: #dcdcda; --accent: #111;
    --display: 'Inter Tight', ui-sans-serif, system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --pad-x: clamp(1.25rem, 4vw, 4rem); --wide: 1120px; --measure: 44rem;
    --t-mega: clamp(3.25rem, 12vw, 9.5rem); --t-big: clamp(2rem, 5vw, 4.25rem); --t-med: clamp(1.35rem, 2.2vw, 1.9rem); --t-small: 0.75rem;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); color: var(--fg); font-family: var(--display); font-size: 18px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  body { margin: 0; }
  a { color: inherit; text-decoration: none; }
  img { max-width: 100%; height: auto; display: block; }

  .kicker, .topbar, .footer, .btn { font-family: var(--mono); font-size: var(--t-small); text-transform: uppercase; letter-spacing: 0.1em; }
  .kicker { color: var(--mute); }
  .kicker a { color: var(--ink); border-bottom: 1px solid currentColor; }
  .dot { display: inline-block; width: 0.55em; height: 0.55em; background: var(--accent); }

  .topbar { position: sticky; top: 0; z-index: 50; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 1.5rem; padding: 0.8rem var(--pad-x); background: rgba(255,255,255,0.9); backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); color: var(--ink); }
  .topbar .mark { display: inline-flex; align-items: center; gap: 0.6rem; font-weight: 600; }
  .topbar nav { display: flex; justify-content: center; gap: clamp(1rem, 3vw, 2.5rem); }
  .btn { display: inline-block; background: var(--accent); color: #fff !important; font-weight: 600; line-height: 34px; padding: 0 16px; white-space: nowrap; }

  .wide { max-width: var(--wide); margin: 0 auto; padding: 0 var(--pad-x); }
  .measure { max-width: var(--measure); }
  .rail { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .section-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding-bottom: 0.9rem; border-bottom: 2px solid var(--ink); }
  .display { font-family: var(--display); color: var(--ink); font-weight: 800; letter-spacing: -0.04em; line-height: 0.95; margin: 0; text-wrap: balance; }
  .display .dot { width: 0.18em; height: 0.18em; margin-left: 0.06em; }

  .prose { font-size: 1.2rem; line-height: 1.6; }
  .prose > :first-child { margin-top: 0; }
  .prose p, .prose ul, .prose ol, .prose blockquote, .prose pre, .prose figure { margin: 0 0 1.4em; }
  .prose h1, .prose h2, .prose h3, .prose h4 { color: var(--ink); font-weight: 700; letter-spacing: -0.025em; line-height: 1.15; margin: 2em 0 0.6em; }
  .prose h2 { font-size: 1.6rem; } .prose h3 { font-size: 1.35rem; }
  .prose a { text-decoration: underline; text-underline-offset: 2px; }
  .prose img { margin: 0 auto; }
  .prose blockquote { margin-left: 0; padding-left: 1.1rem; border-left: 2px solid var(--ink); font-style: italic; }
  .prose code { font-family: var(--mono); font-size: 0.82em; background: #f4f4f2; padding: 0.1em 0.35em; }
  .prose pre { background: #f4f4f2; padding: 1rem 1.2rem; overflow-x: auto; border-left: 2px solid var(--ink); }
  .prose pre code { background: none; padding: 0; }
  .prose .footnotes { margin-top: 3.5rem; padding-top: 1rem; border-top: 2px solid var(--ink); font-size: 15px; color: var(--mute); }
  .prose .footnotes h2 { font-family: var(--mono); font-size: var(--t-small); text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 0.8rem; }

  .footer { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; max-width: var(--wide); margin: 5rem auto 0; padding: 1.25rem var(--pad-x) 3rem; border-top: 1px solid var(--rule); color: var(--mute); }
  .footer nav { display: flex; gap: 1.5rem; }

  @media (max-width: 640px) {
    html { font-size: 17px; } .prose { font-size: 1.0625rem; }
    .topbar nav { justify-content: flex-end; gap: 0.9rem; }
  }
</style>
