---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../../site.config.mjs';
import { website } from '../lib/schema';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const total = posts.length;
const fmt = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', day: '2-digit' });
const num = (n: number) => String(n).padStart(3, '0');
---

<Base canonical={site.site} type="website" jsonLd={[website]}>
  <section class="hero">
    <div class="rail kicker"><span>{site.title} / {new Date().getFullYear()}</span><span>Mirrored from Substack</span></div>
    <h1 class="display hero__title">{site.title}<span class="dot" aria-hidden="true"></span></h1>
    <div class="hero__footer">
      <p class="hero__lede">{site.description}</p>
      <p class="kicker">By <a href={site.personal || site.substack}>{site.author}</a></p>
    </div>
  </section>

  <section>
    <div class="section-head"><span class="kicker">01 / Posts</span><span class="kicker">{total} {total === 1 ? 'entry' : 'entries'}</span></div>
    <ol class="rows" reversed>
      {posts.map((post, i) => (
        <li class="row">
          <a href={`/p/${post.data.slug}`}>
            <div class="row__meta kicker">
              <span>No. {num(total - i)}</span>
              <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
            </div>
            <div>
              <h2 class="display row__title">{post.data.title}</h2>
              {post.data.excerpt && <p class="row__excerpt">{post.data.excerpt}</p>}
              <span class="kicker">Read →</span>
            </div>
          </a>
        </li>
      ))}
    </ol>
    {total === 0 && <p class="kicker" style="padding: 2rem 0">No posts yet. Run <code>npm run sync</code>.</p>}
  </section>
</Base>

<style>
  .hero { padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(2rem, 4vw, 3rem); }
  .hero .rail { margin-bottom: clamp(2rem, 5vw, 4rem); }
  .hero__title { font-size: var(--t-mega); font-weight: 800; letter-spacing: -0.055em; line-height: 0.85; }
  .hero__footer { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 2rem; margin-top: clamp(2rem, 5vw, 4rem); padding-top: 1.25rem; border-top: 1px solid var(--rule); }
  .hero__lede { font-weight: 500; font-size: var(--t-med); line-height: 1.2; letter-spacing: -0.015em; color: var(--ink); max-width: 30ch; margin: 0; }
  .rows { list-style: none; margin: 0; padding: 0; }
  .row { border-top: 1px solid var(--ink); }
  .row:last-child { border-bottom: 2px solid var(--ink); }
  .row a { display: grid; grid-template-columns: minmax(8rem, 12rem) 1fr; gap: clamp(1rem, 3vw, 3rem); padding: clamp(1.5rem, 3vw, 2.5rem) 0; }
  .row__meta { display: flex; flex-direction: column; gap: 0.35rem; color: var(--ink); padding-top: 0.4rem; }
  .row__meta time { color: var(--mute); }
  .row__title { font-size: var(--t-big); margin-bottom: 0.5rem; }
  .row__excerpt { font-size: 1.125rem; line-height: 1.5; color: var(--mute); max-width: 60ch; margin: 0 0 1rem; }
  @media (max-width: 640px) { .hero__footer { grid-template-columns: 1fr; } .row a { grid-template-columns: 1fr; gap: 0.75rem; } .row__meta { flex-direction: row; gap: 1rem; } }
</style>
